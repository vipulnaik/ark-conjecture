/-
# `PartEF.lean` — Part E (realisability) for a fused class, F ≥ 2, via the entangled generator

`enumeration-proof.md` Part E's realisability for one fused p-characteristic class (F blocks of
𝔽_c, full twist) beside one foreign block ℤ/r with twist of odd prime order q — the shape of every
odd Σ₀ cell, including the binding class 11 (F = 4).  With F_mid = F, the F-cycle is carried by the
**entangled cyclic-layer generator** of the text.

* **The entangled generator** `zc ω`: (i, x) ↦ (i + 1, x), except (F − 1, x) ↦ (0, ω·x).  Its
  powers (`zc_pow`): zc^j (i, x) = (i + j, ω^⌊(i + j)/F⌋·x), so zc^F is the full twist on every
  block (`zc_pow_mul`) — rotation and twist from one cyclic subgroup.
* **The group** G = ⟨T, γ, μ(U)⟩ in Perm((ℤ/F × K) ⊔ ℤ/r): T the translations of all blocks,
  γ = zc ⊕ (z ↦ z + 1), μ_u = id ⊕ (z ↦ u·z) for u in the order-q subgroup U.
* **The Oliver chain** (`chain`): N₂ = T, a p-group (`T_pgroup`); N₁ = ⟨T, γ⟩, cyclic over T,
  generated by γ's class (`layer_cyclic`); G/N₁ a q-group, since every element is μ_u times an
  element of N₁ (`decomp`, `top_pgroup`).  Normality: γ and μ_u normalise T (`γ_conj_tr`,
  `μ_conj_tr`), and μ_u normalises N₁ because μ_u γ μ_u⁻¹ = γ·ρ_{u−1} with ρ_v ∈ N₁
  (`ρ_mem`) — the one place coherence r ∤ F·(c − 1) enters.
* **Moving points** (`block_map`): any block onto any block by any affine map, fixing ℤ/r.
* **The orbitals** (`orbit_ge`): within a block, one orbital of F·C(c,2) (`orbit_KK`); across two
  blocks, ≥ K0·c² with K0 = F (odd F), F/2 (even F), the rotation orbit of a block pair
  (`orbit_cross`, `no_swap`); block–ℤ/r, F·c·r (`orbit_KR`); inside ℤ/r, ≥ q·r (`orbit_RR`).
  These are exactly the SAFE terms, the within-class coefficient included.
* **`partE_F`, `partE_F_exists`** — the realisation for F ≥ 2.
* **`PartEAll.sigma0_realised`** — **Σ₀'s floor at every residue class, with Part E proved**:
  under the witness hypothesis with either quantifier, L-eventually n is realised by an Oliver group
  all of whose pair-orbitals are ≥ m with 2m ≥ ((1 − ε)·δ₀(n mod 12) − κ/n)·n(n − 1).
-/
import PartE1

set_option linter.unusedSectionVars false

namespace PartEF
open Equiv Finset

variable {F : ℕ} [Fact (1 < F)] {K : Type*} [Field K]

instance : NeZero F := ⟨by have := (Fact.out : 1 < F); omega⟩

theorem val_succ (i : ZMod F) : (i + 1).val = (i.val + 1) % F := by
  rw [ZMod.val_add, ZMod.val_one]

/-- The entangled generator on F blocks of K: rotate the blocks, multiplying by ω on the wrap. -/
def zc (ω : Kˣ) : Perm (ZMod F × K) where
  toFun p := (p.1 + 1, if p.1.val + 1 = F then (ω : K) * p.2 else p.2)
  invFun p := (p.1 - 1, if p.1.val = 0 then ((ω⁻¹ : Kˣ) : K) * p.2 else p.2)
  left_inv := by
    rintro ⟨i, x⟩
    have hv := val_succ i
    have hi := ZMod.val_lt i
    simp only [add_sub_cancel_right, Prod.mk.injEq, true_and]
    by_cases h : i.val + 1 = F
    · have : (i + 1).val = 0 := by rw [hv, h, Nat.mod_self]
      simp [h, this]
    · have : (i + 1).val ≠ 0 := by
        rw [hv, Nat.mod_eq_of_lt (by omega)]; omega
      simp [h, this]
  right_inv := by
    rintro ⟨i, x⟩
    have hi := ZMod.val_lt i
    simp only [sub_add_cancel, Prod.mk.injEq, true_and]
    have hv := val_succ (i - 1)
    rw [sub_add_cancel] at hv
    by_cases h : i.val = 0
    · have : (i - 1).val + 1 = F := by
        have h2 : (i - 1).val < F := ZMod.val_lt _
        rcases Nat.lt_or_ge ((i - 1).val + 1) F with h3 | h3
        · rw [Nat.mod_eq_of_lt h3] at hv; omega
        · omega
      simp [h, this]
    · have : (i - 1).val + 1 ≠ F := by
        intro h3; rw [h3, Nat.mod_self] at hv; exact h hv
      simp [h, this]

/-- **The power formula**: zc^j (i, x) = (i + j, ω^((i.val + j)/F) · x). -/
theorem zc_pow (ω : Kˣ) (j : ℕ) (i : ZMod F) (x : K) :
    (zc ω ^ j) (i, x) = (i + j, ((ω ^ ((i.val + j) / F) : Kˣ) : K) * x) := by
  induction j with
  | zero =>
    have := ZMod.val_lt i
    simp [Nat.div_eq_of_lt this]
  | succ j ih =>
    rw [pow_succ', Perm.mul_apply, ih]
    simp only [zc, coe_fn_mk, Nat.cast_succ, Prod.mk.injEq]
    refine ⟨by ring, ?_⟩
    have hv : (i + (j : ZMod F)).val = (i.val + j) % F := by
      rw [ZMod.val_add, ZMod.val_natCast, Nat.add_mod_mod]
    rw [hv]
    have hF : 0 < F := by have := (Fact.out : 1 < F); omega
    have h1 : 1 % F = 1 := Nat.mod_eq_of_lt (Fact.out : 1 < F)
    have hm := Nat.mod_lt (i.val + j) hF
    have hmod : (i.val + j + 1) % F = ((i.val + j) % F + 1) % F := by rw [Nat.add_mod, h1]
    have key : (i.val + (j + 1)) / F = (i.val + j) / F + (if (i.val + j) % F + 1 = F then 1 else 0) := by
      rw [← Nat.add_assoc]
      by_cases h : (i.val + j) % F + 1 = F
      · simp only [h, ite_true]
        apply Nat.succ_div_of_dvd
        rw [Nat.dvd_iff_mod_eq_zero, hmod, h, Nat.mod_self]
      · simp only [h, ite_false, add_zero]
        apply Nat.succ_div_of_not_dvd
        rw [Nat.dvd_iff_mod_eq_zero, hmod, Nat.mod_eq_of_lt (by omega)]; omega
    rw [key]
    split <;> simp [pow_add, mul_comm, mul_left_comm]

theorem zc_pow_mul (ω : Kˣ) (m : ℕ) (i : ZMod F) (x : K) :
    (zc ω ^ (F * m)) (i, x) = (i, ((ω ^ m : Kˣ) : K) * x) := by
  rw [zc_pow]
  have hF : 0 < F := by have := (Fact.out : 1 < F); omega
  have hi := ZMod.val_lt i
  have : (i.val + F * m) / F = m := by
    rw [Nat.add_mul_div_left _ _ hF, Nat.div_eq_of_lt hi, zero_add]
  rw [this]; simp

theorem zc_pow_eq_one (ω : Kˣ) (m : ℕ) (hm : ω ^ m = 1) :
    zc (F := F) ω ^ (F * m) = 1 := by
  ext ⟨i, x⟩ <;> rw [zc_pow_mul] <;> simp [hm]

/-! ## The group on F blocks ⊔ ℤ/r -/

variable (F K) in
/-- The points: F blocks of K, and ℤ/r. -/
abbrev Pt (r : ℕ) := (ZMod F × K) ⊕ ZMod r

variable {r : ℕ} [Fact r.Prime]

/-- Translation by t on the blocks (identity on ℤ/r). -/
def trE (t : ZMod F → K) : Perm (ZMod F × K) where
  toFun p := (p.1, p.2 + t p.1)
  invFun p := (p.1, p.2 - t p.1)
  left_inv p := by simp
  right_inv p := by simp

def trHom : Multiplicative (ZMod F → K) →* Perm (Pt F K r) where
  toFun t := Perm.sumCongr (trE (Multiplicative.toAdd t)) 1
  map_one' := by ext (⟨i, x⟩ | z) <;> simp [trE]
  map_mul' s t := by
    ext (⟨i, x⟩ | z)
    · simp [trE]; ring
    · simp

/-- The translation subgroup: N₂. -/
def T : Subgroup (Perm (Pt F K r)) := (trHom (F := F) (K := K) (r := r)).range

/-- The cyclic-layer generator: the entangled rotation on the blocks, z ↦ z + 1 on ℤ/r. -/
def γ (ω : Kˣ) : Perm (Pt F K r) := Perm.sumCongr (zc ω) (Equiv.addRight 1)

/-- The top: z ↦ u·z on ℤ/r. -/
def μ (u : (ZMod r)ˣ) : Perm (Pt F K r) := Perm.sumCongr 1 (PartE1.act (⟨u, 0⟩ : PartE1.Aff1 (ZMod r)))

theorem γ_pow (ω : Kˣ) (k : ℕ) :
    γ (F := F) (K := K) (r := r) ω ^ k = Perm.sumCongr (zc ω ^ k) (Equiv.addRight (1 : ZMod r) ^ k) := by
  have : γ (F := F) (K := K) (r := r) ω = Perm.sumCongrHom _ _ (zc ω, Equiv.addRight 1) := rfl
  rw [this, ← map_pow]; rfl

theorem γ_pow_inl (ω : Kˣ) (k : ℕ) (i : ZMod F) (x : K) :
    (γ (F := F) (K := K) (r := r) ω ^ k) (Sum.inl (i, x)) = Sum.inl ((zc ω ^ k) (i, x)) := by
  rw [γ_pow]; rfl

theorem addRight_pow (k : ℕ) (z : ZMod r) : (Equiv.addRight (1 : ZMod r) ^ k) z = z + k := by
  induction k with
  | zero => simp
  | succ k ih => rw [pow_succ', Perm.mul_apply, ih]; simp; ring

theorem γ_pow_inr (ω : Kˣ) (k : ℕ) (z : ZMod r) :
    (γ (F := F) (K := K) (r := r) ω ^ k) (Sum.inr z) = Sum.inr (z + k) := by
  rw [γ_pow]; simp

/-- Translation by v on ℤ/r only. -/
def ρ (v : ZMod r) : Perm (Pt F K r) := Perm.sumCongr 1 (Equiv.addRight v)

theorem trHom_inl (t : Multiplicative (ZMod F → K)) (i : ZMod F) (x : K) :
    trHom (r := r) t (Sum.inl (i, x)) = Sum.inl (i, x + Multiplicative.toAdd t i) := rfl
theorem trHom_inr (t : Multiplicative (ZMod F → K)) (z : ZMod r) :
    trHom (F := F) (K := K) t (Sum.inr z) = Sum.inr z := rfl

/-- The wrap multiplier of zc at block i. -/
def wrap (ω : Kˣ) (i : ZMod F) : K := if i.val + 1 = F then (ω : K) else 1

theorem zc_apply (ω : Kˣ) (i : ZMod F) (x : K) : zc ω (i, x) = (i + 1, wrap ω i * x) := by
  simp only [zc, coe_fn_mk, wrap]; split <;> simp

/-- **γ normalises the translations**: γ·τ_t = τ_{t'}·γ with t'(j) = wrap(j − 1)·t(j − 1). -/
theorem γ_conj_tr (ω : Kˣ) (t : Multiplicative (ZMod F → K)) :
    γ (r := r) ω * trHom t * (γ ω)⁻¹ =
      trHom (Multiplicative.ofAdd fun j => wrap ω (j - 1) * Multiplicative.toAdd t (j - 1)) := by
  rw [mul_inv_eq_iff_eq_mul]
  ext (⟨i, x⟩ | z)
  · simp only [Perm.mul_apply, trHom_inl, γ, Perm.sumCongr_apply, Sum.map_inl, zc_apply,
      toAdd_ofAdd, add_sub_cancel_right]
    simp only [Sum.inl.injEq, Prod.mk.injEq, true_and]; ring
  · simp [Perm.mul_apply, trHom_inr, γ]

theorem μ_conj_tr (u : (ZMod r)ˣ) (t : Multiplicative (ZMod F → K)) :
    μ u * trHom t * (μ u)⁻¹ = trHom t := by
  rw [mul_inv_eq_iff_eq_mul]
  ext (⟨i, x⟩ | z) <;> simp [Perm.mul_apply, trHom_inl, trHom_inr, μ]

theorem μ_conj_γ (ω : Kˣ) (u : (ZMod r)ˣ) :
    μ u * γ (F := F) (K := K) ω * (μ u)⁻¹ = γ ω * ρ ((u : ZMod r) - 1) := by
  rw [mul_inv_eq_iff_eq_mul]
  ext (⟨i, x⟩ | z)
  · simp [γ, μ, ρ]
  · simp [γ, μ, ρ]; ring

/-! ## The subgroups and the Oliver chain -/

/-- N₁ = ⟨T, γ⟩. -/
def N1 (ω : Kˣ) : Subgroup (Perm (Pt F K r)) :=
  Subgroup.closure (((T (F := F) (K := K) (r := r) : Subgroup _) : Set (Perm (Pt F K r))) ∪ {γ ω})

/-- G = ⟨T, γ, μ(U)⟩. -/
def G (ω : Kˣ) (U : Subgroup (ZMod r)ˣ) : Subgroup (Perm (Pt F K r)) :=
  Subgroup.closure (((T (F := F) (K := K) (r := r) : Subgroup _) : Set (Perm (Pt F K r))) ∪ {γ ω} ∪ (μ '' (U : Set (ZMod r)ˣ)))

theorem T_le_N1 (ω : Kˣ) : (T (F := F) (K := K) (r := r)) ≤ N1 ω :=
  fun _ hx => Subgroup.subset_closure (Or.inl hx)
theorem γ_mem_N1 (ω : Kˣ) : γ ω ∈ N1 (F := F) (K := K) (r := r) ω :=
  Subgroup.subset_closure (Or.inr rfl)
theorem N1_le_G (ω : Kˣ) (U : Subgroup (ZMod r)ˣ) : N1 (F := F) (K := K) ω ≤ G ω U :=
  Subgroup.closure_mono (fun _ hx => Or.inl hx)
theorem μ_mem_G (ω : Kˣ) {U : Subgroup (ZMod r)ˣ} {u : (ZMod r)ˣ} (hu : u ∈ U) :
    μ u ∈ G (F := F) (K := K) ω U :=
  Subgroup.subset_closure (Or.inr ⟨u, hu, rfl⟩)

/-- **ρ_v ∈ N₁** when F·N is invertible mod r (N with ω^N = 1): a power of γ whose exponent is
≡ 0 mod F·N and ≡ v mod r.  This is where r ∤ F·(c − 1) is used. -/
theorem ρ_mem (ω : Kˣ) {N : ℕ} (hN : ω ^ N = 1) (hco : ((F * N : ℕ) : ZMod r) ≠ 0) (v : ZMod r) :
    ρ v ∈ N1 (F := F) (K := K) ω := by
  set w : ℕ := (v * ((F * N : ℕ) : ZMod r)⁻¹).val
  have : ρ v = γ (F := F) (K := K) (r := r) ω ^ (F * (N * w)) := by
    rw [γ_pow, zc_pow_eq_one ω (N * w) (by rw [pow_mul, hN, one_pow])]
    ext (⟨i, x⟩ | z)
    · simp [ρ]
    · simp only [ρ, Perm.sumCongr_apply, Sum.map_inr, Equiv.coe_addRight, addRight_pow]
      congr 1; congr 1
      push_cast
      simp only [w, ZMod.natCast_val, ZMod.cast_id', id]
      rw [← mul_assoc]
      push_cast at hco ⊢
      rw [mul_comm v, ← mul_assoc, mul_inv_cancel₀ hco, one_mul]
  rw [this]
  exact Subgroup.pow_mem _ (γ_mem_N1 ω) _

theorem μ_mul (u v : (ZMod r)ˣ) : μ (F := F) (K := K) (u * v) = μ u * μ v := by
  ext (⟨i, x⟩ | z) <;> simp [μ, mul_assoc]
theorem μ_one : μ (F := F) (K := K) (1 : (ZMod r)ˣ) = 1 := by
  ext (⟨i, x⟩ | z) <;> simp [μ]
theorem μ_inv (u : (ZMod r)ˣ) : μ (F := F) (K := K) u⁻¹ = (μ u)⁻¹ := by
  rw [eq_inv_iff_mul_eq_one, ← μ_mul, inv_mul_cancel, μ_one]
theorem μ_pow (u : (ZMod r)ˣ) (n : ℕ) : μ (F := F) (K := K) (u ^ n) = μ u ^ n := by
  induction n with
  | zero => simp [μ_one]
  | succ n ih => rw [pow_succ, μ_mul, ih, pow_succ]

/-- μ_u normalises N₁ (needs ρ ∈ N₁, hence r ∤ F·N). -/
theorem μ_conj_N1 (ω : Kˣ) {N : ℕ} (hN : ω ^ N = 1) (hco : ((F * N : ℕ) : ZMod r) ≠ 0)
    (u : (ZMod r)ˣ) {n : Perm (Pt F K r)} (hn : n ∈ N1 (F := F) (K := K) ω) :
    μ u * n * (μ u)⁻¹ ∈ N1 (F := F) (K := K) ω := by
  induction hn using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with hx | rfl
    · obtain ⟨t, rfl⟩ := hx
      rw [μ_conj_tr]; exact T_le_N1 ω ⟨t, rfl⟩
    · rw [μ_conj_γ]
      exact Subgroup.mul_mem _ (γ_mem_N1 ω) (ρ_mem ω hN hco _)
  | one => simp
  | mul x y _ _ hx hy =>
    have : μ u * (x * y) * (μ u)⁻¹ = (μ u * x * (μ u)⁻¹) * (μ u * y * (μ u)⁻¹) := by group
    rw [this]; exact Subgroup.mul_mem _ hx hy
  | inv x _ hx =>
    have : μ u * x⁻¹ * (μ u)⁻¹ = (μ u * x * (μ u)⁻¹)⁻¹ := by group
    rw [this]; exact Subgroup.inv_mem _ hx

variable [Fintype K] [DecidableEq K]

theorem T_le_G (ω : Kˣ) (U : Subgroup (ZMod r)ˣ) : (T (F := F) (K := K) (r := r)) ≤ G ω U :=
  le_trans (T_le_N1 ω) (N1_le_G ω U)

instance T_normal (ω : Kˣ) (U : Subgroup (ZMod r)ˣ) :
    ((T (F := F) (K := K) (r := r)).subgroupOf (G ω U)).Normal := by
  rw [Subgroup.normal_subgroupOf_iff_le_normalizer (T_le_G ω U)]
  apply Subgroup.closure_le _ |>.mpr
  intro g hg
  apply Subgroup.mem_normalizer_fintype
  intro n hn
  obtain ⟨t, rfl⟩ := hn
  rcases hg with (hg | rfl) | ⟨u, -, rfl⟩
  · exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hg ⟨t, rfl⟩) (Subgroup.inv_mem _ hg)
  · rw [γ_conj_tr]; exact ⟨_, rfl⟩
  · rw [μ_conj_tr]; exact ⟨_, rfl⟩

section chain
variable (ω : Kˣ) {N : ℕ} (hN : ω ^ N = 1) (hco : ((F * N : ℕ) : ZMod r) ≠ 0) (U : Subgroup (ZMod r)ˣ)
include hN hco

theorem N1_normal : ((N1 (F := F) (K := K) (r := r) ω).subgroupOf (G ω U)).Normal := by
  rw [Subgroup.normal_subgroupOf_iff_le_normalizer (N1_le_G ω U)]
  apply Subgroup.closure_le _ |>.mpr
  intro g hg
  apply Subgroup.mem_normalizer_fintype
  intro n hn
  rcases hg with hg | ⟨u, -, rfl⟩
  · have hgN : g ∈ N1 (F := F) (K := K) ω := Subgroup.subset_closure hg
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hgN hn) (Subgroup.inv_mem _ hgN)
  · exact μ_conj_N1 ω hN hco u hn

omit hN hco in
theorem T_le_N1' : (T (F := F) (K := K) (r := r)).subgroupOf (G ω U) ≤
    (N1 (F := F) (K := K) ω).subgroupOf (G ω U) :=
  fun _ hx => by rw [Subgroup.mem_subgroupOf] at hx ⊢; exact T_le_N1 ω hx

end chain

section chain2
variable (ω : Kˣ) (U : Subgroup (ZMod r)ˣ)

abbrev N1G : Subgroup (G (F := F) (K := K) (r := r) ω U) := (N1 ω).subgroupOf (G ω U)
abbrev TG : Subgroup (G (F := F) (K := K) (r := r) ω U) := (T (F := F) (K := K) (r := r)).subgroupOf (G ω U)
abbrev LayerQ := (N1G (F := F) (K := K) (r := r) ω U) ⧸ (TG ω U).subgroupOf (N1G ω U)

/-- The class in the layer of an element of N₁. -/
def lcls (y : Perm (Pt F K r)) (hyN : y ∈ N1 (F := F) (K := K) ω) : LayerQ (F := F) (K := K) ω U :=
  QuotientGroup.mk ⟨⟨y, N1_le_G ω U hyN⟩, Subgroup.mem_subgroupOf.mpr hyN⟩

theorem lcls_mul (x y : Perm (Pt F K r)) (hx : x ∈ N1 (F := F) (K := K) ω) (hy : y ∈ N1 (F := F) (K := K) ω) :
    lcls ω U (x * y) (Subgroup.mul_mem _ hx hy) = lcls ω U x hx * lcls ω U y hy := rfl

theorem lcls_inv (x : Perm (Pt F K r)) (hx : x ∈ N1 (F := F) (K := K) ω) :
    lcls ω U x⁻¹ (Subgroup.inv_mem _ hx) = (lcls ω U x hx)⁻¹ := rfl

/-- **The cyclic layer**: N₁/N₂ is generated by the class of γ, since N₁ = ⟨T, γ⟩ and T = N₂. -/
theorem layer_cyclic : IsCyclic (LayerQ (F := F) (K := K) (r := r) ω U) := by
  refine ⟨⟨lcls ω U (γ ω) (γ_mem_N1 ω), fun x => ?_⟩⟩
  rw [← Subgroup.mem_zpowers_iff]
  induction x using QuotientGroup.induction_on with
  | H y =>
    obtain ⟨⟨y, hyG⟩, hyN⟩ := y
    have hy : y ∈ N1 (F := F) (K := K) ω := Subgroup.mem_subgroupOf.mp hyN
    show lcls ω U y hy ∈ _
    clear hyN hyG
    induction hy using Subgroup.closure_induction with
    | mem x hx =>
      rcases hx with hx | rfl
      · have : lcls ω U x (Subgroup.subset_closure (Or.inl hx)) = 1 := by
          unfold lcls
          rw [QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf, Subgroup.mem_subgroupOf]
          exact hx
        rw [this]; exact Subgroup.one_mem _
      · exact Subgroup.mem_zpowers _
    | one => exact Subgroup.one_mem _
    | mul x y hx hy ihx ihy =>
      rw [lcls_mul ω U x y hx hy]; exact Subgroup.mul_mem _ ihx ihy
    | inv x hx ihx =>
      rw [lcls_inv ω U x hx]; exact Subgroup.inv_mem _ ihx

/-- Every element of G is μ_u times an element of N₁. -/
theorem decomp {N : ℕ} (hN : ω ^ N = 1) (hco : ((F * N : ℕ) : ZMod r) ≠ 0)
    {g : Perm (Pt F K r)} (hg : g ∈ G (F := F) (K := K) ω U) :
    ∃ u ∈ U, (μ u)⁻¹ * g ∈ N1 (F := F) (K := K) ω := by
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with hx | ⟨u, hu, rfl⟩
    · exact ⟨1, U.one_mem, by rw [μ_one, inv_one, one_mul]; exact Subgroup.subset_closure hx⟩
    · exact ⟨u, hu, by rw [inv_mul_cancel]; exact Subgroup.one_mem _⟩
  | one => exact ⟨1, U.one_mem, by rw [μ_one]; simp⟩
  | mul x y _ _ hx hy =>
    obtain ⟨u, hu, hxn⟩ := hx
    obtain ⟨u', hu', hyn⟩ := hy
    refine ⟨u * u', U.mul_mem hu hu', ?_⟩
    have e : (μ (u * u'))⁻¹ * (x * y) =
        (μ u'⁻¹ * ((μ u)⁻¹ * x) * (μ u'⁻¹)⁻¹) * ((μ u')⁻¹ * y) := by
      rw [μ_mul, μ_inv]; group
    rw [e]
    exact Subgroup.mul_mem _ (μ_conj_N1 ω hN hco _ hxn) hyn
  | inv x _ hx =>
    obtain ⟨u, hu, hxn⟩ := hx
    refine ⟨u⁻¹, U.inv_mem hu, ?_⟩
    have e : (μ u⁻¹)⁻¹ * x⁻¹ = μ u * ((μ u)⁻¹ * x)⁻¹ * (μ u)⁻¹ := by
      rw [μ_inv]; group
    rw [e]
    exact μ_conj_N1 ω hN hco u (Subgroup.inv_mem _ hxn)

/-- **The top is a q-group**: modulo N₁ every element is some μ_u, and u^q = 1. -/
theorem top_pgroup (q : ℕ) {N : ℕ} (hN : ω ^ N = 1) (hco : ((F * N : ℕ) : ZMod r) ≠ 0)
    (hU : ∀ u ∈ U, u ^ q = 1) [(N1G (F := F) (K := K) (r := r) ω U).Normal] :
    IsPGroup q ((G (F := F) (K := K) (r := r) ω U) ⧸ N1G ω U) := by
  intro x
  refine ⟨1, ?_⟩
  induction x using QuotientGroup.induction_on with
  | H g =>
    obtain ⟨g, hg⟩ := g
    obtain ⟨u, hu, hn⟩ := decomp ω U hN hco hg
    have hμG : μ u ∈ G (F := F) (K := K) ω U := μ_mem_G ω hu
    have hnG := N1_le_G ω U hn
    have h1 : (QuotientGroup.mk (⟨g, hg⟩ : G (F := F) (K := K) ω U) :
        (G (F := F) (K := K) (r := r) ω U) ⧸ N1G ω U) = QuotientGroup.mk ⟨μ u, hμG⟩ := by
      rw [QuotientGroup.eq, Subgroup.mem_subgroupOf]
      have : ((⟨g, hg⟩ : G (F := F) (K := K) ω U)⁻¹ * ⟨μ u, hμG⟩ : G (F := F) (K := K) ω U).1 =
          ((μ u)⁻¹ * g)⁻¹ := by simp
      rw [this]; exact Subgroup.inv_mem _ hn
    rw [h1, pow_one, ← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
    have : ((⟨μ u, hμG⟩ : G (F := F) (K := K) ω U) ^ q).1 = 1 := by
      rw [Subgroup.coe_pow, ← μ_pow, hU u hu, μ_one]
    rw [this]; exact Subgroup.one_mem _

theorem T_pgroup (p : ℕ) [Fact p.Prime] [CharP K p] :
    IsPGroup p (TG (F := F) (K := K) (r := r) ω U) := by
  intro x
  refine ⟨1, ?_⟩
  obtain ⟨⟨y, hyG⟩, hyT⟩ := x
  obtain ⟨t, ht⟩ := (Subgroup.mem_subgroupOf.mp hyT : y ∈ T (F := F) (K := K) (r := r))
  apply Subtype.ext; apply Subtype.ext
  simp only [pow_one, Subgroup.coe_pow, OneMemClass.coe_one]
  have ht' : trHom t = y := ht
  rw [← ht', ← map_pow]
  have : t ^ p = 1 := by
    apply Multiplicative.toAdd.injective
    funext i
    simp
  rw [this, map_one]

/-- **The Oliver chain** on G: N₂ = T (translations, a p-group) ◁ N₁ = ⟨T, γ⟩ (cyclic over T)
◁ G (a q-group over N₁). -/
def chain (p q : ℕ) [Fact p.Prime] [CharP K p] {N : ℕ} (hN : ω ^ N = 1)
    (hco : ((F * N : ℕ) : ZMod r) ≠ 0) (hU : ∀ u ∈ U, u ^ q = 1) :
    Chain.OliverChain (G (F := F) (K := K) (r := r) ω U) p q :=
  haveI := N1_normal ω hN hco U
  { N₁ := N1G ω U
    N₂ := TG ω U
    n₁ := inferInstance
    n₂ := inferInstance
    le := T_le_N1' ω U
    bot := T_pgroup ω U p
    layer := layer_cyclic ω U
    top := top_pgroup ω U q hN hco hU }

end chain2

/-! ## Elements of G, and how they move points -/

section elements
variable (ω : Kˣ) (U : Subgroup (ZMod r)ˣ) {N : ℕ} (hN : ω ^ N = 1) (hco : ((F * N : ℕ) : ZMod r) ≠ 0)

theorem trHom_mem (t : Multiplicative (ZMod F → K)) : trHom t ∈ G (F := F) (K := K) (r := r) ω U :=
  T_le_G ω U ⟨t, rfl⟩
theorem γpow_mem (k : ℕ) : γ ω ^ k ∈ G (F := F) (K := K) (r := r) ω U :=
  Subgroup.pow_mem _ (N1_le_G ω U (γ_mem_N1 ω)) k
include hN hco in
theorem ρ_memG (v : ZMod r) : ρ v ∈ G (F := F) (K := K) ω U := N1_le_G ω U (ρ_mem ω hN hco v)

include hN hco in
/-- **Move a block onto any block by any affine map**, fixing ℤ/r. -/
theorem block_map (hω : ∀ a : Kˣ, a ∈ Subgroup.zpowers ω) (i i' : ZMod F) (a : Kˣ) (b : K) :
    ∃ g ∈ G (F := F) (K := K) (r := r) ω U, (∀ v, g (Sum.inl (i, v)) = Sum.inl (i', a * v + b)) ∧
      ∀ z, g (Sum.inr z) = Sum.inr z := by
  set k := (i' - i).val
  set e := (i.val + k) / F
  obtain ⟨m, hm⟩ : ∃ m : ℕ, ω ^ m = a * (ω ^ e)⁻¹ := by
    have := hω (a * (ω ^ e)⁻¹)
    rw [← mem_powers_iff_mem_zpowers] at this
    exact this
  let t : Multiplicative (ZMod F → K) := Multiplicative.ofAdd (fun _ => b)
  refine ⟨ρ (-(k : ZMod r)) * trHom t * (γ ω ^ (F * m) * ρ (-((F * m : ℕ) : ZMod r))) * γ ω ^ k,
    ?_, ?_, ?_⟩
  · refine Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ (ρ_memG ω U hN hco _)
      (trHom_mem ω U t)) (Subgroup.mul_mem _ (γpow_mem ω U _) (ρ_memG ω U hN hco _))) (γpow_mem ω U _)
  · intro v
    have hik : i + (k : ZMod F) = i' := by simp [k]
    simp only [Perm.mul_apply, γ_pow_inl, zc_pow, ρ, Perm.sumCongr_apply, Sum.map_inl,
      Perm.coe_one, id, trHom_inl, hik]
    simp only [Sum.inl.injEq, Prod.mk.injEq]
    have hF : 0 < F := by have := (Fact.out : 1 < F); omega
    have h2 : (i'.val + F * m) / F = m := by
      rw [Nat.add_mul_div_left _ _ hF, Nat.div_eq_of_lt (ZMod.val_lt i'), zero_add]
    refine ⟨by push_cast; simp, ?_⟩
    rw [h2, hm]
    simp only [t, toAdd_ofAdd]
    rw [← mul_assoc, ← Units.val_mul, inv_mul_cancel_right]
  · intro z
    simp only [Perm.mul_apply, γ_pow_inr, ρ, Perm.sumCongr_apply, Sum.map_inr, trHom_inr,
      Equiv.coe_addRight]
    congr 1; push_cast; ring

end elements

/-! ## The orbitals -/

section orbitals
variable (ω : Kˣ) (U : Subgroup (ZMod r)ˣ) {N : ℕ} (hN : ω ^ N = 1) (hco : ((F * N : ℕ) : ZMod r) ≠ 0)
  (hω : ∀ a : Kˣ, a ∈ Subgroup.zpowers ω)

theorem map_mem {g : Perm (Pt F K r)} (hg : g ∈ G (F := F) (K := K) ω U) (e : Sym2 (Pt F K r)) :
    Sym2.map g e ∈ D2.orbit2 (G (F := F) (K := K) ω U) e := by
  unfold D2.orbit2
  rw [Finset.mem_image]
  exact ⟨g, by simp only [Finset.mem_filter, Finset.mem_univ, true_and]; exact hg, rfl⟩

include hN hco hω in
/-- **Within-block pairs: one orbital of size F·C(c,2).** -/
theorem orbit_KK (i : ZMod F) {x y : K} (hxy : x ≠ y) :
    F * (Fintype.card K).choose 2 ≤
      (D2.orbit2 (G (F := F) (K := K) ω U) s(Sum.inl (i, x), Sum.inl (i, y))).card := by
  set T0 : Finset (Sym2 K) := (Finset.univ.offDiag).image Sym2.mk.uncurry
  have hT : T0.card = (Fintype.card K).choose 2 := Sym2.card_image_offDiag _
  set S : Finset (Sym2 (Pt F K r)) := ((Finset.univ : Finset (ZMod F)) ×ˢ T0).image
    (fun w => Sym2.map (fun v => (Sum.inl (w.1, v) : Pt F K r)) w.2)
  have hS : S.card = F * (Fintype.card K).choose 2 := by
    rw [Finset.card_image_of_injective, Finset.card_product, hT, Finset.card_univ, ZMod.card]
    rintro ⟨i1, e1⟩ ⟨i2, e2⟩ h
    induction e1 using Sym2.ind with
    | h a1 b1 =>
    induction e2 using Sym2.ind with
    | h a2 b2 =>
    simp only [Sym2.map_mk, Sym2.eq_iff, Sum.inl.injEq, Prod.mk.injEq] at h
    rcases h with ⟨⟨h1, h2⟩, -, h3⟩ | ⟨⟨h1, h2⟩, -, h3⟩
    · subst h1 h2 h3; rfl
    · subst h1 h2 h3; simp [Sym2.eq_swap]
  rw [← hS]
  apply Finset.card_le_card
  intro f hf
  simp only [S, T0, Finset.mem_image, Finset.mem_product, Finset.mem_univ, true_and,
    Finset.mem_offDiag, Prod.exists] at hf
  obtain ⟨i', g, ⟨x', y', hne, rfl⟩, rfl⟩ := hf
  have hd : y - x ≠ 0 := sub_ne_zero.mpr (Ne.symm hxy)
  set a : K := (y' - x') / (y - x)
  have ha : a ≠ 0 := div_ne_zero (sub_ne_zero.mpr (Ne.symm hne)) hd
  obtain ⟨g, hg, hgl, -⟩ := block_map ω U hN hco hω i i' (Units.mk0 a ha) (x' - a * x)
  have := map_mem ω U hg s(Sum.inl (i, x), Sum.inl (i, y))
  convert this using 1
  simp only [Function.uncurry_apply_pair, Sym2.map_mk, hgl, Units.val_mk0]
  have e1 : a * x + (x' - a * x) = x' := by ring
  have e2 : a * y + (x' - a * x) = y' := by
    have : a * (y - x) = y' - x' := by simp only [a]; field_simp
    linear_combination this
  rw [e1, e2]

include hN hco hω in
/-- **Block–ℤ/r pairs: one orbital of size F·c·r.** -/
theorem orbit_KR (i : ZMod F) (x : K) (z : ZMod r) :
    F * Fintype.card K * r ≤
      (D2.orbit2 (G (F := F) (K := K) ω U) s(Sum.inl (i, x), Sum.inr z)).card := by
  set S : Finset (Sym2 (Pt F K r)) :=
    (Finset.univ : Finset ((ZMod F × K) × ZMod r)).image (fun w => s(Sum.inl w.1, Sum.inr w.2))
  have hS : S.card = F * Fintype.card K * r := by
    rw [Finset.card_image_of_injective]
    · simp [ZMod.card, Fintype.card_prod]
    · intro w w' h
      simp only [Sym2.eq_iff, Sum.inl.injEq, Sum.inr.injEq, reduceCtorEq, and_false, or_false] at h
      exact Prod.ext h.1 h.2
  rw [← hS]
  apply Finset.card_le_card
  intro f hf
  simp only [S, Finset.mem_image, Finset.mem_univ, true_and] at hf
  obtain ⟨⟨⟨i', x'⟩, z'⟩, rfl⟩ := hf
  obtain ⟨g, hg, hgl, hgr⟩ := block_map ω U hN hco hω i i' 1 (x' - x)
  have hm := map_mem ω U (Subgroup.mul_mem _ (ρ_memG ω U hN hco (z' - z)) hg)
    s(Sum.inl (i, x), Sum.inr z)
  convert hm using 1
  simp [Sym2.map_mk, Perm.mul_apply, hgl, hgr, ρ]

include hN hco in
/-- **Pairs inside ℤ/r: orbitals of size ≥ |U|·r** (−1 ∉ U). -/
theorem orbit_RR [Fintype U] {z1 z2 : ZMod r} (hz : z1 ≠ z2) (hneg : (-1 : (ZMod r)ˣ) ∉ U) :
    Fintype.card U * r ≤
      (D2.orbit2 (G (F := F) (K := K) ω U) s(Sum.inr z1, Sum.inr z2)).card := by
  set S : Finset (Sym2 (Pt F K r)) :=
    (Finset.univ : Finset (U × ZMod r)).image
      (fun w => s(Sum.inr (((w.1 : (ZMod r)ˣ) : ZMod r) * z1 + w.2),
                  Sum.inr (((w.1 : (ZMod r)ˣ) : ZMod r) * z2 + w.2)))
  have hd : z1 - z2 ≠ 0 := sub_ne_zero.mpr hz
  have hS : S.card = Fintype.card U * r := by
    rw [Finset.card_image_of_injective]
    · simp [ZMod.card]
    · rintro ⟨⟨u, hu⟩, v⟩ ⟨⟨u', hu'⟩, v'⟩ h
      simp only [Sym2.eq_iff, Sum.inr.injEq] at h
      rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · have huu : (u : ZMod r) = u' := by
          have : ((u : ZMod r) - u') * (z1 - z2) = 0 := by linear_combination h1 - h2
          rcases mul_eq_zero.mp this with h | h
          · exact sub_eq_zero.mp h
          · exact absurd h hd
        have hu2 : u = u' := Units.ext huu
        subst hu2
        have : v = v' := by linear_combination h1
        subst this; rfl
      · exfalso
        have huu : (u : ZMod r) = -(u' : ZMod r) := by
          have : ((u : ZMod r) + u') * (z1 - z2) = 0 := by linear_combination h1 - h2
          rcases mul_eq_zero.mp this with h | h
          · linear_combination h
          · exact absurd h hd
        apply hneg
        have : (-1 : (ZMod r)ˣ) = u * u'⁻¹ := by
          apply Units.ext
          rw [Units.val_mul, huu, neg_mul, Units.mul_inv, Units.val_neg, Units.val_one]
        rw [this]; exact U.mul_mem hu (U.inv_mem hu')
  rw [← hS]
  apply Finset.card_le_card
  intro f hf
  simp only [S, Finset.mem_image, Finset.mem_univ, true_and] at hf
  obtain ⟨⟨⟨u, hu⟩, v⟩, rfl⟩ := hf
  have hm := map_mem ω U (Subgroup.mul_mem _ (ρ_memG ω U hN hco v) (μ_mem_G ω hu))
    s(Sum.inr z1, Sum.inr z2)
  convert hm using 1
  simp [ρ, μ]

/-- The within-class cross coefficient: F for odd F, F/2 for even F. -/
def K0 (F : ℕ) : ℕ := if F % 2 = 1 then F else F / 2

theorem K0_le : K0 F ≤ F := by unfold K0; split <;> omega

/-- Two rotations by k, k' < K0 that swap a pair of distinct blocks coincide. -/
theorem no_swap {k k' : ℕ} (hk : k < K0 F) (hk' : k' < K0 F)
    (h : (2 : ZMod F) * ((k' : ZMod F) - k) = 0) : k = k' := by
  have h' : (((2 * ((k' : ℤ) - k)) : ℤ) : ZMod F) = 0 := by push_cast; exact h
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at h'
  obtain ⟨m, hm⟩ := h'
  have hF : 1 < F := Fact.out
  unfold K0 at hk hk'
  by_cases hodd : F % 2 = 1
  · simp only [hodd, ↓reduceIte] at hk hk'
    rcases lt_trichotomy m 0 with hm0 | hm0 | hm0
    · have : m ≤ -1 := by omega
      have : (F : ℤ) * m ≤ -F := by nlinarith
      rcases lt_or_ge m (-1) with h2 | h2
      · have : (F : ℤ) * m ≤ -2 * F := by nlinarith
        omega
      · have : m = -1 := by omega
        subst this; omega
    · subst hm0; omega
    · rcases lt_or_ge 1 m with h2 | h2
      · have : (F : ℤ) * 2 ≤ F * m := by nlinarith
        omega
      · have : m = 1 := by omega
        subst this; omega
  · simp only [hodd, ↓reduceIte] at hk hk'
    rcases lt_trichotomy m 0 with hm0 | hm0 | hm0
    · have : (F : ℤ) * m ≤ -F := by nlinarith
      omega
    · subst hm0; omega
    · have : (F : ℤ) ≤ F * m := by nlinarith
      omega

include hN hco in
/-- **Pairs across two blocks: orbitals of size ≥ K0·c²**, where K0 = F (odd F), F/2 (even F):
the rotation orbit of a block pair has at least K0 members, and translations make each block
pair carry all c² point pairs. -/
theorem orbit_cross {i j : ZMod F} (hij : i ≠ j) (x y : K) :
    K0 F * Fintype.card K * Fintype.card K ≤
      (D2.orbit2 (G (F := F) (K := K) ω U) s(Sum.inl (i, x), Sum.inl (j, y))).card := by
  set S : Finset (Sym2 (Pt F K r)) :=
    (Finset.range (K0 F) ×ˢ (Finset.univ : Finset (K × K))).image
      (fun w => s(Sum.inl (i + (w.1 : ZMod F), w.2.1), Sum.inl (j + (w.1 : ZMod F), w.2.2)))
  have hval : ∀ k : ℕ, k < K0 F → ((k : ZMod F)).val = k := fun k hk => by
    rw [ZMod.val_natCast, Nat.mod_eq_of_lt (lt_of_lt_of_le hk K0_le)]
  have hS : S.card = K0 F * Fintype.card K * Fintype.card K := by
    rw [Finset.card_image_of_injOn, Finset.card_product, Finset.card_range, Finset.card_univ,
      Fintype.card_prod, mul_assoc]
    rintro ⟨k, a, b⟩ hw ⟨k', a', b'⟩ hw' h
    simp only [Finset.coe_product, Set.mem_prod, Finset.coe_range, Set.mem_Iio] at hw hw'
    simp only [Sym2.eq_iff, Sum.inl.injEq, Prod.mk.injEq] at h
    rcases h with ⟨⟨h1, h2⟩, h3, h4⟩ | ⟨⟨h1, h2⟩, h3, h4⟩
    · have : (k : ZMod F) = k' := by linear_combination h1
      have hkk : k = k' := by rw [← hval k hw.1, ← hval k' hw'.1, this]
      subst hkk h2 h4; rfl
    · exfalso
      have h5 : (2 : ZMod F) * ((k' : ZMod F) - k) = 0 := by linear_combination -h1 - h3
      have hkk := no_swap hw.1 hw'.1 h5
      subst hkk
      exact hij (by linear_combination h1)
  rw [← hS]
  apply Finset.card_le_card
  intro f hf
  simp only [S, Finset.mem_image, Finset.mem_product, Finset.mem_range, Finset.mem_univ,
    and_true] at hf
  obtain ⟨⟨k, x', y'⟩, -, rfl⟩ := hf
  have hne : i + (k : ZMod F) ≠ j + k := fun h => hij (by linear_combination h)
  set e1 := (i.val + k) / F
  set e2 := (j.val + k) / F
  let t : Multiplicative (ZMod F → K) := Multiplicative.ofAdd (fun l =>
    if l = i + k then x' - ((ω ^ e1 : Kˣ) : K) * x else y' - ((ω ^ e2 : Kˣ) : K) * y)
  have hm := map_mem ω U (Subgroup.mul_mem _ (trHom_mem ω U t) (γpow_mem ω U k))
    s(Sum.inl (i, x), Sum.inl (j, y))
  convert hm using 1
  have q1 : ((ω ^ e1 : Kˣ) : K) * x + (x' - ((ω ^ e1 : Kˣ) : K) * x) = x' := by ring
  have q2 : ((ω ^ e2 : Kˣ) : K) * y + (y' - ((ω ^ e2 : Kˣ) : K) * y) = y' := by ring
  have hne' : (j + (k : ZMod F) = i + k) = False := eq_false (Ne.symm hne)
  simp only [Sym2.map_mk, Perm.mul_apply, γ_pow_inl, zc_pow, trHom_inl, t, toAdd_ofAdd,
    hne', ↓reduceIte]
  rw [q1, q2]

include hN hco hω in
/-- **Every orbital is at least min(F·C(c,2), K0·c², |U|·r, F·c·r).** -/
theorem orbit_ge [Fintype U] (hneg : (-1 : (ZMod r)ˣ) ∉ U) (e : Sym2 (Pt F K r)) (he : ¬ e.IsDiag) :
    min (F * (Fintype.card K).choose 2) (min (K0 F * Fintype.card K * Fintype.card K)
      (min (Fintype.card U * r) (F * Fintype.card K * r))) ≤
      (D2.orbit2 (G (F := F) (K := K) ω U) e).card := by
  induction e using Sym2.ind with
  | h x y =>
    rw [Sym2.mk_isDiag_iff] at he
    rcases x with ⟨i, x⟩ | z <;> rcases y with ⟨j, y⟩ | w
    · by_cases hij : i = j
      · subst hij
        have hxy : x ≠ y := fun h => he (by rw [h])
        exact le_trans (min_le_left _ _) (orbit_KK ω U hN hco hω i hxy)
      · exact le_trans (le_trans (min_le_right _ _) (min_le_left _ _))
          (orbit_cross ω U hN hco hij x y)
    · exact le_trans (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _)))
        (orbit_KR ω U hN hco hω i x w)
    · rw [Sym2.eq_swap]
      exact le_trans (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _)))
        (orbit_KR ω U hN hco hω j y z)
    · exact le_trans (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _)))
        (orbit_RR ω U hN hco (fun h => he (by rw [h])) hneg)

end orbitals

/-! ## Realisability for a fused class -/

open ArkCore E6 E5Assembly in
/-- **Part E for a fused class, F ≥ 2** (F blocks of 𝔽_c, c = |K| = p^b, full twist, beside one
foreign block ℤ/r with twist of odd prime order q ∣ r − 1; coherence r ∤ F·(c − 1)).  The group
G = ⟨translations, γ, μ(U)⟩ — γ the entangled rotation, so the F-cycle and the full twist come
from one cyclic subgroup — carries an Oliver chain (p, q), and every orbital on unordered pairs has
size at least SAFE of `SigmaHalf.cfg p q F c r`. -/
theorem partE_F (p q b : ℕ) [Fact p.Prime] [CharP K p]
    (hK : Fintype.card K = p ^ b) (hq : q.Prime) (hqo : q % 2 = 1) (hqr : q ∣ r - 1)
    (hco : ¬ r ∣ p ^ b - 1) (hrF : ¬ r ∣ F) :
    ∃ (ω : Kˣ) (U : Subgroup (ZMod r)ˣ),
      Nonempty (Chain.OliverChain (G (F := F) (K := K) (r := r) ω U) p q) ∧
      ∀ e : Sym2 (Pt F K r), ¬ e.IsDiag →
        (SigmaHalf.cfg p q F (p ^ b) r).safe ≤ (D2.orbit2 (G (F := F) (K := K) ω U) e).card := by
  have : Fact q.Prime := ⟨hq⟩
  have hr2 : 2 ≤ r := (Fact.out : r.Prime).two_le
  have hcard : q ∣ Fintype.card (ZMod r)ˣ := by rw [ZMod.card_units]; exact hqr
  obtain ⟨g, hg⟩ := exists_prime_orderOf_dvd_card q hcard
  set U := Subgroup.zpowers g with hUdef
  have hU : ∀ u ∈ U, u ^ q = 1 := by
    intro u hu
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hu
    rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, ← hg, pow_orderOf_eq_one,
      one_zpow]
  have hq3 : 3 ≤ q := by
    rcases hq.eq_two_or_odd with h | h
    · omega
    · have := hq.two_le; omega
  have hneg : (-1 : (ZMod r)ˣ) ∉ U := by
    intro h
    have h1 := hU _ h
    have hodd : Odd q := Nat.odd_iff.mpr hqo
    rw [hodd.neg_one_pow] at h1
    have : ((-1 : (ZMod r)ˣ) : ZMod r) = 1 := by rw [h1]; rfl
    simp only [Units.val_neg, Units.val_one] at this
    have h2 : ((2 : ℕ) : ZMod r) = 0 := by push_cast; linear_combination -this
    rw [ZMod.natCast_eq_zero_iff] at h2
    have := Nat.le_of_dvd (by norm_num) h2
    have : r = 2 := by omega
    subst this
    have := Nat.le_of_dvd (by norm_num) hqr
    omega
  obtain ⟨ω, hω⟩ := IsCyclic.exists_generator (α := Kˣ)
  have hN : ω ^ (p ^ b - 1) = 1 := by
    have : orderOf ω = p ^ b - 1 := by
      rw [orderOf_eq_card_of_forall_mem_zpowers hω, Nat.card_eq_fintype_card, Fintype.card_units, hK]
    rw [← this]; exact pow_orderOf_eq_one ω
  have hcoF : ((F * (p ^ b - 1) : ℕ) : ZMod r) ≠ 0 := by
    rw [Ne, ZMod.natCast_eq_zero_iff]
    intro h
    rcases (Nat.Prime.dvd_mul Fact.out).mp h with h | h
    · exact hrF h
    · exact hco h
  refine ⟨ω, U, ⟨chain ω U p q hN hcoF hU⟩, fun e he => ?_⟩
  have hUc : Fintype.card U = q := by rw [Fintype.card_zpowers, hg]
  have hmin := orbit_ge ω U hN hcoF hω hneg e he
  rw [hUc, hK] at hmin
  have hd : 2 ≤ (r - 1) / q := by
    obtain ⟨m, hm⟩ := hqr
    have hm2 : 2 ≤ m := by
      rcases Nat.lt_or_ge m 2 with h | h
      · interval_cases m
        · omega
        · have hr : r % 2 = 1 := by
            rcases (Fact.out : r.Prime).eq_two_or_odd with h2 | h2
            · subst h2; omega
            · exact h2
          omega
      · exact h
    rw [hm, Nat.mul_div_cancel_left _ (by omega)]; exact hm2
  have horb : orb r q false = r * q := by
    apply SigmaHalf.orb_dq hqo hd
    have := Nat.div_mul_cancel hqr
    omega
  have hF2 : 2 ≤ F := (Fact.out : 1 < F)
  have h1 : (SigmaHalf.cfg p q F (p ^ b) r).safe ≤ F * pairs (p ^ b) :=
    minL_le (by simp [SigmaHalf.cfg, CPart.safeTerms, Part.terms])
  have h2' : (SigmaHalf.cfg p q F (p ^ b) r).safe ≤ K0 F * p ^ b * p ^ b :=
    minL_le (by simp [SigmaHalf.cfg, CPart.safeTerms, Part.terms, hF2, K0])
  have h2 : (SigmaHalf.cfg p q F (p ^ b) r).safe ≤ orb r q false :=
    minL_le (by simp [SigmaHalf.cfg, CPart.safeTerms, Part.terms])
  have h3 : (SigmaHalf.cfg p q F (p ^ b) r).safe ≤ F * p ^ b * r :=
    minL_le (by simp [SigmaHalf.cfg, CPart.safeTerms, Part.terms, Config.sizes, CPart.sizeC, crossN])
  rw [horb] at h2
  rw [← Ark.pairs_eq_choose] at hmin
  have : (SigmaHalf.cfg p q F (p ^ b) r).safe ≤
      min (F * pairs (p ^ b)) (min (K0 F * p ^ b * p ^ b) (min (q * r) (F * p ^ b * r))) := by
    simp only [le_min_iff]; refine ⟨h1, h2', ?_, h3⟩; rw [mul_comm]; exact h2
  omega

/-- **Part E for F ≥ 2, packaged** with `GaloisField p b`: an Oliver group on F·c + r points all
of whose pair-orbitals are at least SAFE of the configuration. -/
theorem partE_F_exists (p q b : ℕ) [Fact p.Prime] (hb : b ≠ 0) (hq : q.Prime)
    (hqo : q % 2 = 1) (hqr : q ∣ r - 1) (hco : ¬ r ∣ p ^ b - 1) (hrF : ¬ r ∣ F) :
    ∃ (X : Type) (_ : Fintype X) (_ : DecidableEq X) (G : Subgroup (Perm X)),
      Fintype.card X = F * p ^ b + r ∧ Nonempty (Chain.OliverChain G p q) ∧
      ∀ e : Sym2 X, ¬ e.IsDiag → (SigmaHalf.cfg p q F (p ^ b) r).safe ≤ (D2.orbit2 G e).card := by
  classical
  let K := GaloisField p b
  let _ : Fintype K := Fintype.ofFinite K
  have hK : Fintype.card K = p ^ b := by
    rw [← Nat.card_eq_fintype_card]; exact GaloisField.card p b hb
  obtain ⟨ω, U, hch, horb⟩ := partE_F (F := F) (K := K) (r := r) p q b hK hq hqo hqr hco hrF
  refine ⟨Pt F K r, inferInstance, inferInstance, G (F := F) (K := K) ω U, ?_, hch, ?_⟩
  · rw [Fintype.card_sum, Fintype.card_prod, ZMod.card, ZMod.card, hK]
  · intro e he
    convert horb e he using 2

end PartEF

/-! ## Σ₀'s floor at every class, with Part E proved -/

namespace PartEAll
open SigmaHalf Sigma PartE1

theorem F0_le_four (a : Fin 12) : F0 a ≤ 4 := by fin_cases a <;> decide

/-- **Σ₀'s floor at every residue class, with Part E proved rather than assumed.**  Under Σ₀'s
witness hypothesis with either quantifier (L = `atTop` for (AL), `almostAll` for (AA)),
L-eventually every n is realised by an Oliver group all of whose pair-orbitals have size ≥ m, with
2m ≥ ((1 − ε)·δ₀(n mod 12) − κ/n)·n(n − 1).  The F = 1 cells use `PartE1`, the fused cells
(F = 2, 4, including class 11) `PartEF`. -/
theorem sigma0_realised {ε : ℝ} (hε1 : ε < 1) {L : Filter ℕ} (hL : L ≤ Filter.atTop)
    (H : BCG.Hyp (W0 ε) L) :
    ∀ᶠ n in L, ∃ m : ℕ, OliverRealises n m ∧
      ((1 - ε) * capCol (cls n) - (spec0 ε (cls n)).kap / n) * (n * (n - 1)) ≤ 2 * (m : ℝ) := by
  filter_upwards [H, hL (spec0_eventually hε1)] with n hW hl
  obtain ⟨hx, hy⟩ := hl (cls n)
  have hg := specEps_good (F0 (cls n)) (d0 (cls n)) (ε := ε) (F0_pos _) (d0_ge _) hε1.le
  obtain ⟨p, b, q, r, hp, hb, hq, hqo, hr, hrp, hrd, hn, hlo, hhi, hco⟩ := hW
  obtain ⟨-, hs⟩ := cfg_half (spec0 ε (cls n)) hg hp hb hq hqo hr hrp hrd hn hlo hhi hx hy
  have : Fact p.Prime := ⟨hp⟩
  have : Fact r.Prime := ⟨hr⟩
  have hqr : q ∣ r - 1 := ⟨(spec0 ε (cls n)).d, by rw [hrd]; simp [Nat.mul_comm]⟩
  have hF : (spec0 ε (cls n)).F = F0 (cls n) := rfl
  have hd : (spec0 ε (cls n)).d = d0 (cls n) := rfl
  rw [← spec0_tgt ε hε1.le] at *
  by_cases hF1 : F0 (cls n) = 1
  · rw [hF, hF1] at hs hn
    obtain ⟨X, i1, i2, G, hX, hch, horb⟩ := partE_F1_exists p q r b (by omega) hq hqo hqr hco
    exact ⟨_, ⟨X, i1, i2, G, p, q, hp, hq, by rw [hX]; omega, hch, horb⟩, hs⟩
  · have hF2 : 1 < F0 (cls n) := by have := F0_pos (cls n); omega
    have : Fact (1 < F0 (cls n)) := ⟨hF2⟩
    have hrF : ¬ r ∣ F0 (cls n) := by
      intro h
      have h4 := F0_le_four (cls n)
      have := Nat.le_of_dvd (by omega) h
      have hq3 : 3 ≤ q := by
        rcases hq.eq_two_or_odd with h | h
        · omega
        · have := hq.two_le; omega
      have hd2 := d0_ge (cls n)
      have hrd' : r = d0 (cls n) * q + 1 := by rw [← hd]; exact hrd
      have : r ≤ 4 := by omega
      nlinarith
    rw [hF] at hs hn
    obtain ⟨X, i1, i2, G, hX, hch, horb⟩ :=
      PartEF.partE_F_exists (F := F0 (cls n)) (r := r) p q b (by omega) hq hqo hqr hco hrF
    exact ⟨_, ⟨X, i1, i2, G, p, q, hp, hq, by rw [hX]; exact hn.symm, hch, horb⟩, hs⟩

end PartEAll

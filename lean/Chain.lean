/-
# `Chain.lean` — Oliver's chain, and Step 1 of Lemma D2 from it

Lemma D2's Step 1 (`enumeration-proof.md` Part D2) rests on one group-theoretic fact: in an
Oliver group Γ with chain Γ₂ ⊴ Γ₁ ⊴ Γ — Γ₂ a p-group, Γ₁/Γ₂ cyclic, Γ/Γ₁ a q-group — every
r-subgroup is cyclic when r ∉ {p, q}.  This file proves that, and derives Step 1's conclusion
for the translations of an orbit O = Fin F × ZMod r:

* `OliverChain` — the chain, for an abstract finite group.
* `rsub_le_N₁`, `rsub_inf_N₂` — an r-subgroup lies in Γ₁ (its image in the q-group Γ/Γ₁ is
  trivial) and meets Γ₂ trivially (Γ₂ is a p-group).
* `rsub_cyclic` — **every r-subgroup is cyclic**: it embeds in the cyclic layer Γ₁/Γ₂.
* `tr`, `trHom` — the translation (i, x) ↦ (i, x + tᵢ) of O, and the injective hom from the
  vector group.
* `step1_translations` — for a group acting faithfully on O with an Oliver chain, the
  translations in the image are the multiples of **one** vector v ("T\* ≅ C_r generated by
  one vector").
* `step1_full_support`, `step1_diagonal` — if every block sees a nonzero translation (the
  text's "transitivity forces every component nonzero"), v has full support, and the
  per-block rescaling x ↦ x / vᵢ sends v to the diagonal 𝟙.

* `OliverChain.map`, `step1_Gamma` — the chain passes to images, so Step 1 holds for Γ acting
  on O by any hom ρ (Γ|_O is the image).

* `rElem_is_translation`, `conj_translation`, **`step1_full`** — Step 1 complete: given Lemma
  B's affine form and transitivity of Γ|_O on O, an element of order r exists (Cauchy, since
  F·r divides |Γ|_O|), it is a nonzero translation, and conjugating it around the blocks
  shows the generator v has **every component nonzero**.

* `exists_translation`, `step2_common_mult` — **Step 2's first claim** for Γ|_O itself:
  every element's multipliers satisfy aᵢvᵢ = λ·v_{σi}, i.e. are all equal once v = 𝟙.

* `not_rsq_dvd` — **Sylow-r of Γ|_O is T\***: r² ∤ |Γ|_O|, since a subgroup of order r² would
  consist of translations k·v, of which there are only r.  So Q = Γ|_O/T\* has order prime to
  r, the input Step 2's H¹ = 0 needs (`Step2.lean`).

**Not formalised.** Lemma B itself (each block action is affine), which is a hypothesis of
`step1_full`; and Step 2's second claim, the H¹(Q, V) = 0 change of origins.  Step 2's
H¹(Q, V) = 0 origin change is not attempted.
-/
import Mathlib
import D2

namespace Chain

/-- Oliver's chain on a finite group H at primes p (bottom) and q (top). -/
structure OliverChain (H : Type*) [Group H] (p q : ℕ) where
  N₁ : Subgroup H
  N₂ : Subgroup H
  n₁ : N₁.Normal
  n₂ : N₂.Normal
  le : N₂ ≤ N₁
  bot : IsPGroup p N₂
  layer : IsCyclic (N₁ ⧸ N₂.subgroupOf N₁)
  top : IsPGroup q (H ⧸ N₁)

variable {H : Type*} [Group H] {p q r : ℕ}

/-- An element whose order divides a power of r and a power of p ≠ r (primes) is trivial. -/
theorem eq_one_of_orderOf_dvd_two {x : H} {a b i j : ℕ} (ha : a.Prime) (hb : b.Prime)
    (hab : a ≠ b) (h1 : orderOf x ∣ a ^ i) (h2 : orderOf x ∣ b ^ j) : x = 1 := by
  have hc : Nat.Coprime (a ^ i) (b ^ j) :=
    Nat.Coprime.pow i j ((Nat.coprime_primes ha hb).mpr hab)
  have : orderOf x ∣ 1 := hc ▸ Nat.dvd_gcd h1 h2
  exact orderOf_eq_one_iff.mp (Nat.dvd_one.mp this)

theorem orderOf_dvd_of_isPGroup {P : Subgroup H} (hP : IsPGroup r P) {g : H} (hg : g ∈ P) :
    ∃ k, orderOf g ∣ r ^ k := by
  obtain ⟨k, hk⟩ := isPGroup_iff_orderOf_dvd_pow.mp hP ⟨g, hg⟩
  exact ⟨k, by rwa [Subgroup.orderOf_mk] at hk⟩

/-- An r-subgroup lies in Γ₁: its image in the q-group Γ/Γ₁ is trivial. -/
theorem rsub_le_N₁ (C : OliverChain H p q) (hr : r.Prime) (hq : q.Prime) (hrq : r ≠ q)
    {P : Subgroup H} (hP : IsPGroup r P) : P ≤ C.N₁ := by
  have := C.n₁
  intro g hg
  obtain ⟨k, hk⟩ := orderOf_dvd_of_isPGroup hP hg
  obtain ⟨m, hm⟩ := isPGroup_iff_orderOf_dvd_pow.mp C.top (QuotientGroup.mk g)
  have h1 : orderOf (QuotientGroup.mk g : H ⧸ C.N₁) ∣ r ^ k :=
    (orderOf_map_dvd (QuotientGroup.mk' C.N₁) g).trans hk
  have := eq_one_of_orderOf_dvd_two hr hq hrq h1 hm
  exact (QuotientGroup.eq_one_iff g).mp this

/-- An r-subgroup meets the p-group Γ₂ trivially. -/
theorem rsub_inf_N₂ (C : OliverChain H p q) (hr : r.Prime) (hp : p.Prime) (hrp : r ≠ p)
    {P : Subgroup H} (hP : IsPGroup r P) {g : H} (hg : g ∈ P) (hg2 : g ∈ C.N₂) : g = 1 := by
  obtain ⟨k, hk⟩ := orderOf_dvd_of_isPGroup hP hg
  obtain ⟨m, hm⟩ := isPGroup_iff_orderOf_dvd_pow.mp C.bot ⟨g, hg2⟩
  rw [Subgroup.orderOf_mk] at hm
  exact eq_one_of_orderOf_dvd_two hr hp hrp hk hm

/-- **Every r-subgroup is cyclic** (r ∉ {p, q}): it embeds in the cyclic layer Γ₁/Γ₂. -/
theorem rsub_cyclic (C : OliverChain H p q) (hr : r.Prime) (hp : p.Prime) (hq : q.Prime)
    (hrp : r ≠ p) (hrq : r ≠ q) {P : Subgroup H} (hP : IsPGroup r P) : IsCyclic P := by
  have := C.n₂
  have : (C.N₂.subgroupOf C.N₁).Normal := Subgroup.normal_subgroupOf
  have := C.layer
  have hle := rsub_le_N₁ C hr hq hrq hP
  let f : P →* C.N₁ ⧸ C.N₂.subgroupOf C.N₁ :=
    (QuotientGroup.mk' _).comp (Subgroup.inclusion hle)
  have hf : Function.Injective f := by
    rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
    intro x hx
    rw [MonoidHom.mem_ker] at hx
    simp only [f, MonoidHom.coe_comp, Function.comp_apply, QuotientGroup.mk'_apply,
      QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf] at hx
    have := rsub_inf_N₂ C hr hp hrp hP x.2 hx
    rw [Subgroup.mem_bot]
    exact Subtype.ext this
  exact isCyclic_of_surjective (MonoidHom.ofInjective hf).symm
    (MonoidHom.ofInjective hf).symm.surjective

/-- **The chain descends to quotients**: the image of Γ under a surjective hom (e.g. Γ → Γ|_O)
carries the image chain. -/
def OliverChain.map {G : Type*} [Group G] (C : OliverChain G p q) (f : G →* H)
    (hf : Function.Surjective f) : OliverChain H p q where
  N₁ := C.N₁.map f
  N₂ := C.N₂.map f
  n₁ := by have := C.n₁; exact Subgroup.Normal.map this f hf
  n₂ := by have := C.n₂; exact Subgroup.Normal.map this f hf
  le := Subgroup.map_mono C.le
  bot := C.bot.map f
  layer := by
    have := C.n₂
    have : (C.N₂.subgroupOf C.N₁).Normal := Subgroup.normal_subgroupOf
    have hN : ((C.N₂.map f).subgroupOf (C.N₁.map f)).Normal := by
      have := Subgroup.Normal.map C.n₂ f hf
      exact Subgroup.normal_subgroupOf
    have := C.layer
    let g : C.N₁ →* C.N₁.map f := f.subgroupMap C.N₁
    have hg : Function.Surjective g := f.subgroupMap_surjective C.N₁
    let φ : C.N₁ ⧸ C.N₂.subgroupOf C.N₁ →* C.N₁.map f ⧸ (C.N₂.map f).subgroupOf (C.N₁.map f) :=
      QuotientGroup.map _ _ g (by
        intro x hx
        rw [Subgroup.mem_comap, Subgroup.mem_subgroupOf]
        exact Subgroup.mem_map_of_mem f (Subgroup.mem_subgroupOf.mp hx))
    exact isCyclic_of_surjective φ (QuotientGroup.map_surjective_of_surjective _ _ g
      ((QuotientGroup.mk'_surjective _).comp hg) _)
  top := by
    have := C.n₁
    have := Subgroup.Normal.map C.n₁ f hf
    let φ : G ⧸ C.N₁ →* H ⧸ C.N₁.map f :=
      QuotientGroup.map _ _ f (Subgroup.le_comap_map f C.N₁)
    exact C.top.of_surjective φ (QuotientGroup.map_surjective_of_surjective _ _ f
      ((QuotientGroup.mk'_surjective _).comp hf) _)

/-! ### Translations of an orbit -/

abbrev Pt (F r : ℕ) := Fin F × ZMod r

variable {F : ℕ}

/-- The translation (i, x) ↦ (i, x + tᵢ). -/
def tr (t : Fin F → ZMod r) : Equiv.Perm (Pt F r) where
  toFun pt := (pt.1, pt.2 + t pt.1)
  invFun pt := (pt.1, pt.2 - t pt.1)
  left_inv pt := by simp
  right_inv pt := by simp

/-- Translations as a hom from the vector group. -/
def trHom : Multiplicative (Fin F → ZMod r) →* Equiv.Perm (Pt F r) where
  toFun t := tr (Multiplicative.toAdd t)
  map_one' := by ext pt <;> simp [tr]
  map_mul' a b := by
    ext pt
    · rfl
    · simp only [tr, Equiv.coe_fn_mk, Equiv.Perm.coe_mul, Function.comp_apply, toAdd_mul,
        Pi.add_apply]
      ring

theorem trHom_injective : Function.Injective (trHom (F := F) (r := r)) := by
  intro a b h
  apply Multiplicative.toAdd.injective
  funext i
  have := congrArg (fun g : Equiv.Perm (Pt F r) => (g (i, 0)).2) h
  simpa [trHom, tr] using this

/-- **Step 1: the translations are the multiples of one vector.**  For a group H acting
faithfully on O (`ι` injective) with an Oliver chain and r ∉ {p, q}, the elements of H acting
as translations form an r-group, hence a cyclic one, so every such translation is k·v for a
single vector v. -/
theorem step1_translations (C : OliverChain H p q) (hr : r.Prime) (hp : p.Prime)
    (hq : q.Prime) (hrp : r ≠ p) (hrq : r ≠ q) (ι : H →* Equiv.Perm (Pt F r))
    (hι : Function.Injective ι) :
    ∃ v : Fin F → ZMod r, ∀ h : H, ι h ∈ (trHom (F := F) (r := r)).range →
      ∃ k : ℤ, ι h = trHom (Multiplicative.ofAdd (k • v)) := by
  have : Fact r.Prime := ⟨hr⟩
  let T : Subgroup H := (trHom (F := F) (r := r)).range.comap ι
  -- T is an r-group: each element's image is a translation, killed by the r-th power
  have hT : IsPGroup r T := by
    intro x
    refine ⟨1, ?_⟩
    obtain ⟨t, ht⟩ := x.2
    apply Subtype.ext
    apply hι
    simp only [pow_one, Subgroup.coe_pow, map_pow, Subgroup.coe_one, map_one]
    rw [← ht, ← map_pow]
    have : t ^ r = 1 := by
      apply Multiplicative.toAdd.injective
      funext i
      simp [toAdd_pow]
    rw [this, map_one]
  have := rsub_cyclic C hr hp hq hrp hrq hT
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := T)
  obtain ⟨v, hv⟩ := g.2
  refine ⟨Multiplicative.toAdd v, fun h hh => ?_⟩
  obtain ⟨k, hk⟩ := hg ⟨h, hh⟩
  refine ⟨k, ?_⟩
  have hk' : (g : H) ^ k = h := congrArg Subtype.val hk
  rw [← hk', map_zpow, ← hv, ← map_zpow]
  congr 1

/-- **Step 1 for Γ itself.**  Γ with an Oliver chain acting on O by ρ: the translations in the
image Γ|_O are the multiples of one vector.  (The chain passes to Γ|_O by `OliverChain.map`.) -/
theorem step1_Gamma {G : Type*} [Group G] (C : OliverChain G p q) (hr : r.Prime)
    (hp : p.Prime) (hq : q.Prime) (hrp : r ≠ p) (hrq : r ≠ q)
    (ρ : G →* Equiv.Perm (Pt F r)) :
    ∃ v : Fin F → ZMod r, ∀ g : G, ρ g ∈ (trHom (F := F) (r := r)).range →
      ∃ k : ℤ, ρ g = trHom (Multiplicative.ofAdd (k • v)) := by
  obtain ⟨v, hv⟩ := step1_translations (C.map ρ.rangeRestrict ρ.rangeRestrict_surjective)
    hr hp hq hrp hrq ρ.range.subtype (Subgroup.subtype_injective _)
  exact ⟨v, fun g hg => hv (ρ.rangeRestrict g) hg⟩

/-- Every component of the generator is nonzero, if each block sees a nonzero translation. -/
theorem step1_full_support (v : Fin F → ZMod r)
    (hcomp : ∀ i, ∃ k : ℤ, (k • v) i ≠ 0) : ∀ i, v i ≠ 0 := by
  intro i hvi
  obtain ⟨k, hk⟩ := hcomp i
  apply hk
  simp [hvi]

/-- With full support, rescaling block i by vᵢ⁻¹ sends v to the diagonal 𝟙. -/
theorem step1_diagonal [Fact r.Prime] (v : Fin F → ZMod r) (hv : ∀ i, v i ≠ 0) :
    (fun i => (v i)⁻¹ * v i) = fun _ => (1 : ZMod r) := by
  funext i
  exact inv_mul_cancel₀ (hv i)

/-! ### Block-transitivity: the generator has full support (the `hcomp` input)

Lemma B gives each element an affine form on the blocks, (i, x) ↦ (σi, aᵢ·x + tᵢ) with aᵢ ≠ 0.
From that and point-transitivity of Γ|_O:

* `rElem_is_translation` — an element of r-power order is a pure translation (σ = 1 by
  `D2.step1_sigma`, each aᵢ = 1 by `D2.step1_mult`): Step 1's first sentence.
* `conj_translation` — conjugating τ_t by an affine h gives τ_w with w_{σi} = aᵢ·tᵢ.
* `step1_full` — **Step 1 complete**: with an Oliver chain, F < r, r ∉ {p, q}, every element
  affine (Lemma B) and Γ|_O transitive on O, there is a vector v with **every component
  nonzero** such that the translations in Γ|_O are exactly multiples of v.  So after the
  per-block rescaling of `step1_diagonal`, T\* is the diagonal C_r — the text's Step 1. -/

/-- Lemma B's affine form of an element on O. -/
def Affine (g : Equiv.Perm (Pt F r)) (σ : Equiv.Perm (Fin F)) (a t : Fin F → ZMod r) : Prop :=
  ∀ pt : Pt F r, g pt = (σ pt.1, a pt.1 * pt.2 + t pt.1)

theorem affine_pow_fst {g : Equiv.Perm (Pt F r)} {σ : Equiv.Perm (Fin F)} {a t : Fin F → ZMod r}
    (hg : Affine g σ a t) : ∀ (n : ℕ) (pt : Pt F r), ((g ^ n) pt).1 = (σ ^ n) pt.1
  | 0, pt => rfl
  | n + 1, pt => by
    rw [pow_succ', pow_succ', Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hg,
      affine_pow_fst hg n pt]

theorem affine_pow_one {g : Equiv.Perm (Pt F r)} {a t : Fin F → ZMod r}
    (hg : Affine g 1 a t) : ∀ n : ℕ, ∃ c : Fin F → ZMod r,
      ∀ pt : Pt F r, (g ^ n) pt = (pt.1, a pt.1 ^ n * pt.2 + c pt.1)
  | 0 => ⟨0, fun pt => by simp⟩
  | n + 1 => by
    obtain ⟨c, hc⟩ := affine_pow_one hg n
    refine ⟨fun i => a i * c i + t i, fun pt => ?_⟩
    rw [pow_succ', Equiv.Perm.mul_apply, hc, hg]
    simp only [Equiv.Perm.one_apply]
    congr 1
    ring

/-- **An element of r-power order is a pure translation** (F < r). -/
theorem rElem_is_translation [Fact r.Prime] (hFr : F < r) {g : Equiv.Perm (Pt F r)}
    {σ : Equiv.Perm (Fin F)} {a t : Fin F → ZMod r} (ha : ∀ i, a i ≠ 0) (hg : Affine g σ a t)
    {k : ℕ} (hk : g ^ (r ^ k) = 1) : g = trHom (Multiplicative.ofAdd t) := by
  have hr : r.Prime := Fact.out
  -- σ has r-power order, so σ = 1
  have hσk : σ ^ (r ^ k) = 1 := by
    ext i
    have := affine_pow_fst hg (r ^ k) (i, 0)
    rw [hk] at this
    simp only [Equiv.Perm.one_apply] at this
    exact congrArg Fin.val this.symm
  have hσ : σ = 1 := by
    obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow hr).mp (orderOf_dvd_of_pow_eq_one hσk)
    exact D2.step1_sigma hr hFr hj
  subst hσ
  -- each aᵢ has r-power order in (ZMod r)ˣ, so aᵢ = 1
  obtain ⟨c, hc⟩ := affine_pow_one hg (r ^ k)
  have ha1 : ∀ i, a i = 1 := by
    intro i
    have h0 := hc (i, 0)
    have h1 := hc (i, 1)
    rw [hk] at h0 h1
    simp only [Equiv.Perm.one_apply, Prod.mk.injEq, mul_zero, zero_add, mul_one,
      true_and] at h0 h1
    have hN : a i ^ (r ^ k) = 1 := by rw [← h0] at h1; simpa using h1.symm
    let u : (ZMod r)ˣ := Units.mk0 (a i) (ha i)
    have hu : u ^ (r ^ k) = 1 := Units.ext (by simp [u, hN])
    obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow hr).mp (orderOf_dvd_of_pow_eq_one hu)
    have := D2.step1_mult hj
    simpa [u] using congrArg Units.val this
  ext pt
  · simp [hg pt, trHom, tr]
  · simp [hg pt, ha1, trHom, tr]

/-- Conjugating a translation by an affine element gives a translation. -/
theorem conj_translation {h : Equiv.Perm (Pt F r)} {σ : Equiv.Perm (Fin F)}
    {a t' : Fin F → ZMod r} (hh : Affine h σ a t') (t : Fin F → ZMod r) :
    h * trHom (Multiplicative.ofAdd t) * h⁻¹ =
      trHom (Multiplicative.ofAdd fun j => a (σ.symm j) * t (σ.symm j)) := by
  rw [mul_inv_eq_iff_eq_mul]
  ext pt
  · simp [hh pt, hh (pt.1, _), trHom, tr]
  · simp only [Equiv.Perm.mul_apply, trHom, MonoidHom.coe_mk, OneHom.coe_mk, tr,
      Equiv.coe_fn_mk, toAdd_ofAdd, hh pt, hh (pt.1, _), Equiv.symm_apply_apply]
    ring

/-- **D2's Step 1, complete.**  An Oliver chain on Γ|_O = G, F < r, r ∉ {p, q}, every element
affine with nonzero multipliers (Lemma B), and G transitive on O: the translations in G are
the multiples of a vector v with every component nonzero. -/
theorem step1_full [Fact r.Prime] (G : Subgroup (Equiv.Perm (Pt F r))) (C : OliverChain G p q)
    (hp : p.Prime) (hq : q.Prime) (hrp : r ≠ p) (hrq : r ≠ q) (hFr : F < r) (hF : 0 < F)
    (hB : ∀ g ∈ G, ∃ σ a t, (∀ i, a i ≠ 0) ∧ Affine g σ a t)
    (htr : ∀ x y : Pt F r, ∃ g ∈ G, g x = y) :
    ∃ v : Fin F → ZMod r, (∀ i, v i ≠ 0) ∧ ∀ g ∈ G, g ∈ (trHom (F := F) (r := r)).range →
      ∃ k : ℤ, g = trHom (Multiplicative.ofAdd (k • v)) := by
  classical
  have hr : r.Prime := Fact.out
  obtain ⟨v, hv⟩ := step1_translations C hr hp hq hrp hrq G.subtype (Subgroup.subtype_injective _)
  have hv' : ∀ g ∈ G, g ∈ (trHom (F := F) (r := r)).range →
      ∃ k : ℤ, g = trHom (Multiplicative.ofAdd (k • v)) := fun g hg hgr => hv ⟨g, hg⟩ hgr
  refine ⟨v, ?_, hv'⟩
  -- r divides |G|: G is transitive on F·r points
  let p0 : Pt F r := (⟨0, hF⟩, 0)
  have hpre : MulAction.IsPretransitive G (Pt F r) :=
    ⟨fun x y => by obtain ⟨g, hg, hgy⟩ := htr x y; exact ⟨⟨g, hg⟩, hgy⟩⟩
  have horb : MulAction.orbit G p0 = Set.univ := MulAction.orbit_eq_univ G p0
  have hcard := MulAction.card_orbit_mul_card_stabilizer_eq_card_group G p0
  have hco : Fintype.card (MulAction.orbit G p0) = F * r := by
    rw [Fintype.card_congr (Equiv.subtypeUnivEquiv (fun x => horb ▸ Set.mem_univ x))]
    simp [ZMod.card]
  have hdvd : r ∣ Fintype.card G := by
    rw [← hcard, hco]; exact Dvd.dvd.mul_right (dvd_mul_left r F) _
  -- an element of order r is a nonzero translation τ_t
  obtain ⟨g, hgo⟩ := exists_prime_orderOf_dvd_card r hdvd
  obtain ⟨σ, a, t, ha, hga⟩ := hB g g.2
  have hgr : (g : Equiv.Perm (Pt F r)) ^ (r ^ 1) = 1 := by
    rw [pow_one]
    have := pow_orderOf_eq_one g
    rw [hgo] at this
    exact congrArg Subtype.val this
  have hgt := rElem_is_translation hFr ha hga hgr
  have ht0 : t ≠ 0 := by
    intro h0
    have : g = 1 := by
      apply Subtype.ext; rw [hgt, h0]; exact map_one _
    rw [this, orderOf_one] at hgo
    exact hr.one_lt.ne hgo
  obtain ⟨i0, hi0⟩ : ∃ i, t i ≠ 0 := by
    by_contra h; push Not at h; exact ht0 (funext h)
  -- conjugating τ_t to each block j: the j-th component of a translation in G is nonzero
  intro j
  obtain ⟨h, hh, hhj⟩ := htr (i0, 0) (j, 0)
  obtain ⟨σ', a', t', ha', hha⟩ := hB h hh
  have hσ : σ' i0 = j := by have := congrArg Prod.fst hhj; rw [hha] at this; exact this
  have hmem : h * trHom (Multiplicative.ofAdd t) * h⁻¹ ∈ G :=
    G.mul_mem (G.mul_mem hh (hgt ▸ g.2)) (G.inv_mem hh)
  rw [conj_translation hha] at hmem
  obtain ⟨k, hk⟩ := hv' _ hmem ⟨_, rfl⟩
  have hk' := congrArg Multiplicative.toAdd (trHom_injective hk)
  have hj := congrFun hk' j
  simp only [toAdd_ofAdd, Pi.smul_apply] at hj
  rw [← hσ, Equiv.symm_apply_apply] at hj
  intro hvj
  rw [← hσ] at hvj
  rw [hvj, smul_zero] at hj
  exact mul_ne_zero (ha' i0) hi0 hj

/-! ### Step 2's first claim, for the group itself -/

/-- A transitive Γ|_O with Lemma B's affine form contains a nonzero translation (Cauchy). -/
theorem exists_translation [Fact r.Prime] (G : Subgroup (Equiv.Perm (Pt F r))) (hFr : F < r)
    (hF : 0 < F) (hB : ∀ g ∈ G, ∃ σ a t, (∀ i, a i ≠ 0) ∧ Affine g σ a t)
    (htr : ∀ x y : Pt F r, ∃ g ∈ G, g x = y) :
    ∃ t : Fin F → ZMod r, t ≠ 0 ∧ trHom (Multiplicative.ofAdd t) ∈ G := by
  classical
  have hr : r.Prime := Fact.out
  let p0 : Pt F r := (⟨0, hF⟩, 0)
  have hpre : MulAction.IsPretransitive G (Pt F r) :=
    ⟨fun x y => by obtain ⟨g, hg, hgy⟩ := htr x y; exact ⟨⟨g, hg⟩, hgy⟩⟩
  have horb : MulAction.orbit G p0 = Set.univ := MulAction.orbit_eq_univ G p0
  have hcard := MulAction.card_orbit_mul_card_stabilizer_eq_card_group G p0
  have hco : Fintype.card (MulAction.orbit G p0) = F * r := by
    rw [Fintype.card_congr (Equiv.subtypeUnivEquiv (fun x => horb ▸ Set.mem_univ x))]
    simp [ZMod.card]
  have hdvd : r ∣ Fintype.card G := by
    rw [← hcard, hco]; exact Dvd.dvd.mul_right (dvd_mul_left r F) _
  obtain ⟨g, hgo⟩ := exists_prime_orderOf_dvd_card r hdvd
  obtain ⟨σ, a, t, ha, hga⟩ := hB g g.2
  have hgr : (g : Equiv.Perm (Pt F r)) ^ (r ^ 1) = 1 := by
    rw [pow_one]
    have := pow_orderOf_eq_one g
    rw [hgo] at this
    exact congrArg Subtype.val this
  have hgt := rElem_is_translation hFr ha hga hgr
  refine ⟨t, ?_, hgt ▸ g.2⟩
  intro h0
  have : g = 1 := by
    apply Subtype.ext; rw [hgt, h0]; exact map_one _
  rw [this, orderOf_one] at hgo
  exact hr.one_lt.ne hgo

/-- **Step 2's first claim, for Γ|_O.**  With v the full-support generator of `step1_full`,
every element's multipliers satisfy aᵢ·vᵢ = λ·v_{σi} for one λ — so after the rescaling of
`step1_diagonal` (v = 𝟙) all multipliers of an element are equal. -/
theorem step2_common_mult [Fact r.Prime] (G : Subgroup (Equiv.Perm (Pt F r)))
    (C : OliverChain G p q) (hp : p.Prime) (hq : q.Prime) (hrp : r ≠ p) (hrq : r ≠ q)
    (hFr : F < r) (hF : 0 < F)
    (hB : ∀ g ∈ G, ∃ σ a t, (∀ i, a i ≠ 0) ∧ Affine g σ a t)
    (htr : ∀ x y : Pt F r, ∃ g ∈ G, g x = y) :
    ∃ v : Fin F → ZMod r, (∀ i, v i ≠ 0) ∧ ∀ g ∈ G, ∀ σ a t', Affine g σ a t' →
      ∃ c : ZMod r, ∀ i, a i * v i = c * v (σ i) := by
  obtain ⟨v, hvf, hv⟩ := step1_full G C hp hq hrp hrq hFr hF hB htr
  obtain ⟨t, ht0, htG⟩ := exists_translation G hFr hF hB htr
  obtain ⟨k0, hk0⟩ := hv _ htG ⟨_, rfl⟩
  have ht : t = k0 • v := congrArg Multiplicative.toAdd (trHom_injective hk0)
  have hc0 : (k0 : ZMod r) ≠ 0 := by
    intro h; apply ht0; rw [ht]; funext i; simp [zsmul_eq_mul, h]
  refine ⟨v, hvf, fun g hg σ a t' hga => ?_⟩
  have hmem : g * trHom (Multiplicative.ofAdd t) * g⁻¹ ∈ G :=
    G.mul_mem (G.mul_mem hg htG) (G.inv_mem hg)
  rw [conj_translation hga] at hmem
  obtain ⟨k, hk⟩ := hv _ hmem ⟨_, rfl⟩
  have hk' := congrArg Multiplicative.toAdd (trHom_injective hk)
  refine ⟨(k : ZMod r) / (k0 : ZMod r), fun i => ?_⟩
  have hi := congrFun hk' (σ i)
  rw [ht] at hi
  simp only [toAdd_ofAdd, Equiv.symm_apply_apply, zsmul_eq_mul, Pi.mul_apply,
    Pi.intCast_apply] at hi
  field_simp
  linear_combination hi

/-! ### Sylow-r of Γ|_O is T\* (so |Q| = |Γ|_O / T\*| is prime to r) -/

/-- **r² does not divide |Γ|_O|.**  A subgroup of order r² would consist of r-elements, hence
(Step 1) of translations k·v, of which there are at most r.  So Sylow-r of Γ|_O is T\* ≅ C_r,
and Q = Γ|_O / T\* has order prime to r — the input Step 2's H¹ = 0 needs. -/
theorem not_rsq_dvd [Fact r.Prime] (G : Subgroup (Equiv.Perm (Pt F r))) (C : OliverChain G p q)
    (hp : p.Prime) (hq : q.Prime) (hrp : r ≠ p) (hrq : r ≠ q) (hFr : F < r) (hF : 0 < F)
    (hB : ∀ g ∈ G, ∃ σ a t, (∀ i, a i ≠ 0) ∧ Affine g σ a t)
    (htr : ∀ x y : Pt F r, ∃ g ∈ G, g x = y) : ¬ r ^ 2 ∣ Nat.card G := by
  classical
  have hr : r.Prime := Fact.out
  obtain ⟨v, hvf, hv⟩ := step1_full G C hp hq hrp hrq hFr hF hB htr
  intro hdvd
  obtain ⟨P, hP⟩ := Sylow.exists_subgroup_card_pow_prime r hdvd
  let i0 : Fin F := ⟨0, hF⟩
  have htrans : ∀ x : P, ∃ k : ℤ, ((x : G) : Equiv.Perm (Pt F r)) =
      trHom (Multiplicative.ofAdd (k • v)) := by
    intro x
    have hx : x ^ (r ^ 2) = 1 := by rw [← hP]; exact pow_card_eq_one'
    have hx' : ((x : G) : Equiv.Perm (Pt F r)) ^ (r ^ 2) = 1 := by
      have := congrArg (fun y : P => ((y : G) : Equiv.Perm (Pt F r))) hx
      simpa using this
    obtain ⟨σ, a, t, ha, hga⟩ := hB _ (x : G).2
    have hgt := rElem_is_translation hFr ha hga hx'
    exact hv _ (x : G).2 ⟨_, hgt.symm⟩
  let f : P → ZMod r := fun x => (((x : G) : Equiv.Perm (Pt F r)) (i0, 0)).2
  have hf : Function.Injective f := by
    intro x y hxy
    obtain ⟨k, hk⟩ := htrans x
    obtain ⟨k', hk'⟩ := htrans y
    simp only [f, hk, hk', trHom, tr, MonoidHom.coe_mk, OneHom.coe_mk, Equiv.coe_fn_mk,
      toAdd_ofAdd, zero_add, zsmul_eq_mul] at hxy
    have hkk : (k : ZMod r) = k' := mul_right_cancel₀ (hvf i0) hxy
    apply Subtype.ext; apply Subtype.ext
    rw [hk, hk']
    congr 2
    funext i
    simp [zsmul_eq_mul, hkk]
  have hle := Nat.card_le_card_of_injective f hf
  rw [hP, Nat.card_zmod] at hle
  have := hr.two_le
  nlinarith

end Chain

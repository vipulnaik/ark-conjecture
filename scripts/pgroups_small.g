# pgroups_small.g -- p-subgroups of S_n with their orbitals on pairs, in the
# line format of oliver_tom.g (order|transitive|exact|[p]|[p]|orbitals), for
# `verify_global_chi.py` at degrees with no table of marks.
#   p > PMIN:  every subgroup of a Sylow p-subgroup, up to conjugacy in it;
#   p <= PMIN: NRAND subgroups generated by up to four random elements of it.
# Run: gap -q pgroups_small.g     (writes pgroups14.txt and pgroups18.txt)
Run := function(n, PMIN, NRAND)
  local out, p, S, c, H, L, i, Emit;
  out := OutputTextFile(Concatenation("pgroups", String(n), ".txt"), false); SetPrintFormattingStatus(out, false);
  Emit := function(H, p)
    if Size(H) > 1 then
      AppendTo(out, String(Size(H)), "|", String(IsTransitive(H,[1..n])), "|true|[", String(p), "]|[", String(p), "]|",
        ReplacedString(String(OrbitsDomain(H, Combinations([1..n],2), OnSets))," ",""), "\n");
    fi; end;
  for p in Filtered([3..n], IsPrimeInt) do
    S := SylowSubgroup(SymmetricGroup(n), p);
    if p > PMIN then
      for c in ConjugacyClassesSubgroups(S) do Emit(Representative(c), p); od;
    else
      Reset(GlobalMersenneTwister, 20261111);
      for i in [1..NRAND] do
        Emit(Subgroup(S, List([1..Random([2..4])], j -> Random(S))), p);
      od;
    fi;
  od;
  CloseStream(out);
end;;
Run(14, 2, 0); Run(18, 3, 300); QUIT;
